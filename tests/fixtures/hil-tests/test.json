    { "measurement": "led_state", "limit": { "kind": "expect", "value": "green" } }
  ],
  "decision_rule": { "kind": "guard_band", "w_multiple": 1.0 },
  "setup_terms": [ { "name": "cable_drop", "unit": "V", "u": 0.005, "k": 2.0 } ],
  "sources": [
    { "measurement": "dut_vbus_report", "unit": "V", "range_min": 0.0, "range_max": 20.0, "resolution": 0.01, "u": 0.05, "k": 2.0 }
  ],
  "tags": ["vbus", "source"]
}
